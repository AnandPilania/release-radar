# Copy to .env and fill in only what you use. A channel with empty values is skipped.
# Everything here is also read from the real environment (which wins over .env).

# ---- Channels (use any combination) ----------------------------------------
# Slack: Incoming Webhook URL (treat as a secret)
SLACK_WEBHOOK_URL=

# Telegram: bot token from @BotFather + the chat id to post to
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via SMTP. Port 465 = implicit TLS, 587/25 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# WhatsApp Cloud API (Meta). Needs an APPROVED template with exactly ONE body variable {{1}}.
WA_TOKEN=
WA_PHONE_ID=
WA_TO=
WA_TEMPLATE=release_alert
WA_LANG=en
# Graph API version. Meta retires versions ~2 years after the next one ships; check their changelog.
WA_API_VERSION=v25.0

# ---- Display / runtime ------------------------------------------------------
DISPLAY_TZ=UTC
# STATE_FILE=state.json          # where dedupe state lives (mount a volume here in Docker)
# SOURCES_FILE=sources.json
# WEBHOOK_HOST=0.0.0.0           # use 127.0.0.1 if a reverse proxy runs on the same host

# ---- GitHub webhook receiver (repos/orgs you admin) -------------------------
# Same secret goes in the GitHub webhook settings. Generate: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# ---- Mail listener (IMAP IDLE) ----------------------------------------------
# A DEDICATED mailbox subscribed to mailing lists + GitHub "Watch > Custom > Releases".
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
